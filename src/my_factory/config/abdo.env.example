# Copy to abdo.env (git-ignored) and set your local colcon workspace paths.
#   cp config/abdo.env.example config/abdo.env
#   source config/abdo.env
#
# Package paths (maps, URDF, meshes) are resolved by ROS 2 via
# get_package_share_directory / package:// — only workspace roots vary per machine.

# Colcon workspace that contains this repo's install/setup.bash
export ABDO_WS="${ABDO_WS:-$HOME/Desktop/assist}"

# Optional second workspace (must provide ign_ros2_control for Panda sim)
export ABDO_EXTRA_WS="${ABDO_EXTRA_WS:-$HOME/ros2_workspaces/ros2_ws}"
