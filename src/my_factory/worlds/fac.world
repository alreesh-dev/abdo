            <ambient>0.45 0.29 0.07 1</ambient>
            <diffuse>0.45 0.29 0.07 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-6.2 -7.4 0.05 0 0 0</pose>
    </model>

