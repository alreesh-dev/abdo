<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 🟢 تم تغيير الاسم إلى base_camera_joint -->
    <joint name="base_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_camera_link"/>
        <origin xyz="0.38 0.0 0.115" rpy="0 0 0"/> 
    </joint>

    <!-- 🟢 تم تغيير الاسم إلى base_camera_link -->
    <link name="base_camera_link">
        <visual>
            <geometry> <box size="0.03 0.1 0.03"/> </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry> <box size="0.03 0.1 0.03"/> </geometry>
        </collision>
        <xacro:inertial_box mass="0.05" x="0.03" y="0.1" z="0.03">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- 🟢 تم تغيير الاسم إلى base_camera_depth_joint وربطه بالروابط الجديدة -->
    <joint name="base_camera_depth_joint" type="fixed">
        <parent link="base_camera_link"/>
        <child link="base_camera_depth_frame"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="base_camera_depth_frame"/>

    <!-- 🟢 تحديث المرجع ليتوافق مع الرابط الجديد -->
    <gazebo reference="base_camera_link">
        <sensor name="depth_camera" type="gpu_lidar">
            <always_on>1</always_on>
            <update_rate>5.0</update_rate>
            <visualize>true</visualize>
            <topic>/base_camera/scan</topic>
            <!-- 🟢 تحديث الإطار الوهمي لليدار -->
            <gz_frame_id>base_camera_depth_frame</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>60</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.8</min_angle>
                        <max_angle>0.8</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>10</samples>
                        <resolution>1</resolution>
                        <!-- 🟢 تم تعديل الزوايا لتتجنب الأرض وترصد الصناديق المنخفضة -->
                        <min_angle>-0.05</min_angle>
                        <max_angle>0.2</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>3.5</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
        </sensor>
    </gazebo>

</robot>