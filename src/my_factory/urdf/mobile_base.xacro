<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.8"/>
    <xacro:property name="base_width" value="0.8"/>
    <xacro:property name="base_height" value="0.1"/>
    <xacro:property name="wheel_radius" value="0.10"/>
    <xacro:property name="base_z_offset" value="${wheel_radius}"/>
    
    <xacro:property name="wheel_thickness" value="0.05"/>
    <xacro:property name="wheel_offset_x" value="0.32"/>
    <xacro:property name="wheel_offset_y" value="0.42"/>
    
    <xacro:property name="pillar_height" value="0.8"/>
    <xacro:property name="pillar_side" value="0.04"/>
    <xacro:property name="pillar_offset_x" value="0.36"/>
    <xacro:property name="pillar_offset_y" value="0.36"/>
    
    <xacro:property name="bar_radius" value="0.01"/>
    <xacro:property name="bar_length" value="0.72"/>
  
    <link name="base_footprint"/>
    
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <geometry> <box size="${base_length} ${base_width} ${base_height}"/> </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry> <box size="${base_length} ${base_width} ${base_height}"/> </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        </collision>
        <xacro:inertial_box mass="15.0" x="${base_length}" y="${base_width}" z="${base_height}">
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <geometry> <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/> </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <material name="black"/>
            </visual>
            <collision>
                <geometry> <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/> </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </collision>
            <xacro:inertial_cylinder mass="0.5" length="${wheel_thickness}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_reflect*wheel_offset_x} ${y_reflect*wheel_offset_y} 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <dynamics damping="0.1" friction="0.1"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="pillar" params="prefix x_reflect y_reflect">
        <link name="${prefix}_pillar">
            <visual> <geometry> <box size="${pillar_side} ${pillar_side} ${pillar_height}"/> </geometry> <material name="white"/> </visual>
            <collision> <geometry> <box size="${pillar_side} ${pillar_side} ${pillar_height}"/> </geometry> </collision>
            <xacro:inertial_box mass="0.2" x="${pillar_side}" y="${pillar_side}" z="${pillar_height}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>
        <joint name="${prefix}_pillar_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${prefix}_pillar"/>
            <origin xyz="${x_reflect*pillar_offset_x} ${y_reflect*pillar_offset_y} ${pillar_height/2 + base_height}" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="crossbars" params="side_name length r p y x_pos y_pos">
        <link name="${side_name}_bar">
            <visual> <geometry> <cylinder radius="${bar_radius}" length="${length}"/> </geometry> <material name="white"/> </visual>
            <collision> <geometry> <cylinder radius="${bar_radius}" length="${length}"/> </geometry> </collision>
            <xacro:inertial_cylinder mass="0.1" length="${length}" radius="${bar_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <joint name="${side_name}_bar_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${side_name}_bar"/>
            <origin xyz="${x_pos} ${y_pos} ${pillar_height + base_height}" rpy="${r} ${p} ${y}"/>
        </joint>
    </xacro:macro>

    <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
    <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
    <xacro:wheel prefix="back_left" x_reflect="-1" y_reflect="1"/>
    <xacro:wheel prefix="back_right" x_reflect="-1" y_reflect="-1"/>

    <xacro:pillar prefix="front_left" x_reflect="1" y_reflect="1"/>
    <xacro:pillar prefix="front_right" x_reflect="1" y_reflect="-1"/>
    <xacro:pillar prefix="back_left" x_reflect="-1" y_reflect="1"/>
    <xacro:pillar prefix="back_right" x_reflect="-1" y_reflect="-1"/>

    <xacro:crossbars side_name="back" length="${bar_length}" r="${pi/2}" p="0" y="0" x_pos="${-pillar_offset_x}" y_pos="0"/>
    <xacro:crossbars side_name="right" length="${bar_length}" r="0" p="${pi/2}" y="0" x_pos="0" y_pos="${-pillar_offset_y}"/>
    <xacro:crossbars side_name="left" length="${bar_length}" r="0" p="${pi/2}" y="0" x_pos="0" y_pos="${pillar_offset_y}"/>

    <xacro:macro name="wheel_gazebo" params="prefix">
        <gazebo reference="${prefix}_wheel">
            <mu1 value="0.2"/>
            <mu2 value="0.2"/>
            <fdir1 value="1 0 0"/>
            <kp value="1000000.0"/>
            <kd value="10.0"/>
            <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>

    <xacro:wheel_gazebo prefix="front_left"/>
    <xacro:wheel_gazebo prefix="front_right"/>
    <xacro:wheel_gazebo prefix="back_left"/>
    <xacro:wheel_gazebo prefix="back_right"/>

    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <link name="imu_link">
        <visual>
            <geometry> <box size="0.05 0.05 0.05"/> </geometry>
            <material name="black"/>
        </visual>
        <xacro:inertial_box mass="0.01" x="0.05" y="0.05" z="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0.1"/>
    </joint>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>100</update_rate>
            <visualize>true</visualize>
            <topic>/imu</topic>
            <gz_frame_id>imu_link</gz_frame_id>
            <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu">
            </plugin>
        </sensor>
    </gazebo>

</robot>