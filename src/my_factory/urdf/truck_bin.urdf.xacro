<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="truck_bin">

    <!-- 1. القاعدة الأساسية للشاحنة -->
    <link name="truck_base_link">
        <visual>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
            <geometry>
                <box size="2.5 0.4 0.2"/>
            </geometry>
            <material name="truck_color">
                <color rgba="0.8 0.3 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
            <geometry>
                <box size="2.5 0.4 0.2"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="20.0"/>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
            <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.5"/>
        </inertial>
    </link>

    <!-- تعريف العجلات الأربع -->
    <xacro:macro name="wheel" params="prefix x_pos y_pos">
        <link name="${prefix}_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.5707 0 0"/>
                <geometry>
                    <cylinder radius="0.08" length="0.05"/>
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.5707 0 0"/>
                <geometry>
                    <cylinder radius="0.08" length="0.05"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="1.0"/>
                <origin xyz="0 0 0" rpy="1.5707 0 0"/>
                <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
            </inertial>
        </link>

        <joint name="${prefix}_wheel_joint" type="fixed">
            <parent link="truck_base_link"/>
            <child link="${prefix}_wheel_link"/>
            <origin xyz="${x_pos} ${y_pos} 0.08" rpy="0 0 0"/>
        </joint>

        <gazebo reference="${prefix}_wheel_link">
            <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>

    <!-- استدعاء العجلات الأربع -->
    <xacro:wheel prefix="front_right" x_pos="1.0"  y_pos="-0.22"/>
    <xacro:wheel prefix="front_left"  x_pos="1.0"  y_pos="0.22"/>
    <xacro:wheel prefix="back_right"  x_pos="-1.0" y_pos="-0.22"/>
    <xacro:wheel prefix="back_left"   x_pos="-1.0" y_pos="0.22"/>

    <!-- 2. حواف صندوق الشاحنة (بارتفاع 20 سم / 0.2 متر) -->
    <!-- الجدار الجانبي الأيمن -->
    <link name="right_wall_link">
        <visual><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><box size="2.3 0.02 0.2"/></geometry><material name="wall_color"><color rgba="0.7 0.7 0.7 1.0"/></material></visual>
        <collision><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><box size="2.3 0.02 0.2"/></geometry></collision>
        <inertial><mass value="2.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
    </link>
    <joint name="right_wall_joint" type="fixed">
        <parent link="truck_base_link"/><child link="right_wall_link"/><origin xyz="0.0 -0.19 0.35" rpy="0 0 0"/>
    </joint>

    <!-- الجدار الجانبي الأيسر -->
    <link name="left_wall_link">
        <visual><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><box size="2.3 0.02 0.2"/></geometry><material name="wall_color"><color rgba="0.7 0.7 0.7 1.0"/></material></visual>
        <collision><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><box size="2.3 0.02 0.2"/></geometry></collision>
        <inertial><mass value="2.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
    </link>
    <joint name="left_wall_joint" type="fixed">
        <parent link="truck_base_link"/><child link="left_wall_link"/><origin xyz="0.0 0.19 0.35" rpy="0 0 0"/>
    </joint>

    <!-- الجدار الخلفي -->
    <link name="back_wall_link">
        <visual><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><box size="0.02 0.4 0.2"/></geometry><material name="wall_color"><color rgba="0.7 0.7 0.7 1.0"/></material></visual>
        <collision><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><box size="0.02 0.4 0.2"/></geometry></collision>
        <inertial><mass value="1.0"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
    </link>
    <joint name="back_wall_joint" type="fixed">
        <parent link="truck_base_link"/><child link="back_wall_link"/><origin xyz="-1.15 0 0.35" rpy="0 0 0"/>
    </joint>

    <!-- الجدار الأمامي -->
    <link name="front_wall_link">
        <visual><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><box size="0.02 0.4 0.2"/></geometry><material name="wall_color"><color rgba="0.7 0.7 0.7 1.0"/></material></visual>
        <collision><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><box size="0.02 0.4 0.2"/></geometry></collision>
        <inertial><mass value="1.0"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
    </link>
    <joint name="front_wall_joint" type="fixed">
        <parent link="truck_base_link"/><child link="front_wall_link"/><origin xyz="1.15 0 0.35" rpy="0 0 0"/>
    </joint>

    <!-- 3. التعليقة القوسية (نصف دائرة / U مقلوبة) في المقدمة -->
    <link name="front_arch_hook_link">
        <visual>
            <origin xyz="0 0 0.1" rpy="0 1.5707 0"/>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <material name="hook_color">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.1" rpy="0 1.5707 0"/>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>
    <joint name="front_arch_hook_joint" type="fixed">
        <parent link="truck_base_link"/>
        <child link="front_arch_hook_link"/>
        <!-- في منتصف العرض بالمقدمة فوق القاعدة البرتقالية -->
        <origin xyz="1.15 0 0.35" rpy="0 0 0"/>
    </joint>

    <!-- 4. التعليقة القوسية (نصف دائرة / U مقلوبة) في المؤخرة -->
    <link name="back_arch_hook_link">
        <visual>
            <origin xyz="0 0 0.1" rpy="0 1.5707 0"/>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <material name="hook_color">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.1" rpy="0 1.5707 0"/>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>
    <joint name="back_arch_hook_joint" type="fixed">
        <parent link="truck_base_link"/>
        <child link="back_arch_hook_link"/>
        <!-- في منتصف العرض بالمؤخرة فوق القاعدة البرتقالية -->
        <origin xyz="-1.15 0 0.35" rpy="0 0 0"/>
    </joint>

    <!-- تعريف المظهر في جازيبو -->
    <gazebo reference="truck_base_link"><material>Gazebo/Orange</material></gazebo>
    <gazebo reference="right_wall_link"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="left_wall_link"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="back_wall_link"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="front_wall_link"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="front_arch_hook_link"><material>Gazebo/Black</material></gazebo>
    <gazebo reference="back_arch_hook_link"><material>Gazebo/Black</material></gazebo>

</robot>