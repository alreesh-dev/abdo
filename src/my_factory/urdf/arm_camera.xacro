<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="arm_camera" params="prefix parent topic *origin">
        <link name="${prefix}_camera_link">
            <visual>
                <geometry>
                    <box size="0.04 0.04 0.04"/> 
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1.0"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.04 0.04 0.04"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.05"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>

        <!-- ربط الكاميرا بالإطار المرجعي مع تمرير الإحداثيات -->
        <joint name="${prefix}_camera_joint" type="fixed">
            <xacro:insert_block name="origin"/>
            <parent link="${parent}"/>
            <child link="${prefix}_camera_link"/>
        </joint>

        <!-- إعدادات حساس الكاميرا في Gazebo -->
        <gazebo reference="${prefix}_camera_link">
            <sensor name="${prefix}_camera" type="rgbd">
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.01</near>
                        <far>20.0</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30.0</update_rate>
                <visualize>true</visualize>
                <topic>${topic}</topic>
            </sensor>
            
            <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
                <render_engine>ogre2</render_engine>
            </plugin>
        </gazebo>
    </xacro:macro>

</robot>